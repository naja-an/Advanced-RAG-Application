# --- Required ---
GOOGLE_API_KEY=

# --- Models (defaults shown) ---
# RAG_MODEL=gemini-3.5-flash-lite
# RAG_EMBEDDING_MODEL=gemini-embedding-2-preview
# RAG_EVALUATION_MODEL=          # defaults to RAG_MODEL
# RAG_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Storage ---
# RAG_DATABASE_PATH=data/app.sqlite3
# RAG_UPLOAD_DIR=data/uploads
# RAG_SESSION_TTL_HOURS=          # unset = sessions never expire

# --- Observability (optional) ---
# LOG_LEVEL=INFO
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# DEEPEVAL_TELEMETRY_OPT_OUT=YES
